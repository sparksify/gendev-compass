# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public base URL used when generating portal links (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=GenDev Capital
# Hex color, e.g. #0f2a43
NEXT_PUBLIC_PRIMARY_COLOR=
NEXT_PUBLIC_ACCENT_COLOR=
NEXT_PUBLIC_ADVISOR_NAME=Darko
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_PRIVACY_POLICY_URL=
NEXT_PUBLIC_TERMS_URL=

# ---------------------------------------------------------------------------
# Supabase (server-only — never expose the service-role key to the browser).
# Leave empty in local development to use the file-backed dev store instead.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Wistia
# ---------------------------------------------------------------------------
# The media ID of the investor overview video (the hashed ID in the Wistia URL).
WISTIA_MEDIA_ID=
NEXT_PUBLIC_WISTIA_MEDIA_ID=
# Percent of the video (1–100) required to unlock the questionnaire.
VIDEO_COMPLETION_THRESHOLD=85

# ---------------------------------------------------------------------------
# Calendar (any iframe-compatible provider: Calendly, HighLevel, Cal.com, …)
# ---------------------------------------------------------------------------
CALENDAR_EMBED_URL=
NEXT_PUBLIC_CALENDAR_EMBED_URL=

# ---------------------------------------------------------------------------
# Internal access
# ---------------------------------------------------------------------------
# Required in production. Sent as the x-api-key header to POST /api/leads.
INTERNAL_API_KEY=
# Password for the /admin/create-lead testing page.
ADMIN_TEST_PASSWORD=
# Authorizes the scheduled data-refresh cron jobs (see
# docs/territory-advisor.md, "Fully automated"). Vercel sends this
# automatically as a Bearer token on every cron invocation once set.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Territory Intelligence data pipeline
# ---------------------------------------------------------------------------
# U.S. Census Bureau API key (free, instant signup at
# api.census.gov/data/key_signup.html). Required in practice — census.gov
# rejects all unauthenticated requests with HTTP 403.
CENSUS_API_KEY=
# Comma-separated USPS state codes to limit ZIP boundary coverage to.
# Defaults to the whole country (all 50 states + DC, shipped in data/zcta/).
TERRITORY_POLYGON_STATES=

# ---------------------------------------------------------------------------
# Platform domain (multi-organization / multi-brand)
# ---------------------------------------------------------------------------
# Which organization and brand new leads and portal links attach to when the
# caller does not specify one. Single-tenant deployments can leave these
# unset. The brand slug resolves against the Territory Advisor's
# franchise_brands table ('cmdt' is seeded by migration 0005).
DEFAULT_ORGANIZATION_SLUG=gendev
DEFAULT_BRAND_SLUG=cmdt

# ---------------------------------------------------------------------------
# Advisor backend
# ---------------------------------------------------------------------------
# Pilot behavior: advisors see every investor (Darko is the only advisor).
# Set to "false" to restrict advisors to their assigned investors.
ADVISOR_SEES_ALL=true
# Shared secrets for the provider webhooks. Each endpoint refuses all
# requests until its secret is configured.
CALENDAR_WEBHOOK_SECRET=
FDD_WEBHOOK_SECRET=
# Development-only: override the seeded staff login passwords (npm run seed:advisor).
SEED_ADMIN_PASSWORD=
SEED_ADVISOR_PASSWORD=
SEED_ADVISOR2_PASSWORD=

# ---------------------------------------------------------------------------
# Qualification tuning (optional overrides)
# ---------------------------------------------------------------------------
# Score at/above which a lead is flagged as strong (informational for MVP).
QUALIFICATION_SCORE_THRESHOLD=60

# ---------------------------------------------------------------------------
# Advisor notifications (see docs/notifications.md)
#
# All server-only — never expose the API key to the browser. With these
# unset, activity is still recorded and shown in the dashboard; nothing is
# emailed. That is the intended state for local development and CI.
# ---------------------------------------------------------------------------
# Resend API key (resend.com → API Keys). Sending permission is enough.
RESEND_API_KEY=
# Verified sender. Resend rejects addresses on unverified domains, so this
# must be a domain you have verified in Resend. Display name is optional:
#   NOTIFICATION_FROM_EMAIL=GenDev Compass <compass@notifications.example.com>
NOTIFICATION_FROM_EMAIL=
# Fallback recipient used when an investor has no active assigned advisor.
# The assigned advisor's own address always takes precedence.
DEFAULT_ADVISOR_NOTIFICATION_EMAIL=
# Opt in to an immediate email when an investor finishes the overview video.
# Off by default — the event is always recorded for the dashboard either way.
NOTIFY_ON_VIDEO_COMPLETED=false

# ---------------------------------------------------------------------------
# Analytics (optional — the portal works fully without PostHog)
# ---------------------------------------------------------------------------
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# Tracking & Attribution (Google Tag Manager / Meta Pixel / Meta CAPI)
# See docs/tracking-attribution.md. All of this is also configurable from
# /admin/tracking — admin-saved values there always win over these env vars,
# which act only as deploy-time fallbacks/defaults.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Server-only. NEVER prefix this with NEXT_PUBLIC_ — it must never reach the
# browser, HTML, API responses, or dataLayer.
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
# 32-byte key (hex or base64) used to encrypt a Meta CAPI access token saved
# through the /admin/tracking UI, at rest. Without this set, the admin UI
# cannot save a token directly — only the META_CAPI_ACCESS_TOKEN env var
# above works. Generate one with: openssl rand -base64 32
TRACKING_ENCRYPTION_KEY=
# Verbose [Tracking] console logging (dispatch decisions per event). Dev/
# preview only — silently ignored in production.
TRACKING_DEBUG=false

# ---------------------------------------------------------------------------
# FDD workflow / GoHighLevel integration (all server-only)
# ---------------------------------------------------------------------------
# Preferred: API mode — the contact is upserted with the request tag, then
# enrolled directly in the FDD workflow (no trigger configuration needed in
# GoHighLevel). Use a Private Integration token (pit-...) with Contacts +
# Workflows scopes. Location and workflow IDs have single-brand defaults in
# lib/config/fdd.ts; set these only to override.
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_FDD_WORKFLOW_ID=
# Alternative: an inbound-webhook trigger URL for the GoHighLevel FDD
# workflow (used only when no API token is configured).
GHL_FDD_WEBHOOK_URL=
GHL_FDD_REQUEST_TAG=FDD_REQUESTED
# HMAC-SHA256 secret for inbound provider webhooks (x-fdd-signature header).
# Required in production — unsigned events are rejected there.
FDD_WEBHOOK_SECRET=
# Waiting period between FDD acknowledgment and franchise-agreement
# eligibility. Confirm the exact legal duration with franchise counsel.
FDD_WAITING_PERIOD_DAYS=14

# Advisor dashboard: shows the advisor's real GoHighLevel calendar bookings
# for the current day. Reuses GHL_API_TOKEN / GHL_LOCATION_ID above — only
# the calendar ID is new. Find it in GoHighLevel under
# Settings → Calendars → (calendar) → the ID in the URL.
GHL_CALENDAR_ID=
# IANA time zone used to display FDD timestamps to prospects.
NEXT_PUBLIC_BRAND_TIMEZONE=America/Chicago

# ---------------------------------------------------------------------------
# Territory Advisor (all server-only; see docs/territory-advisor.md)
# ---------------------------------------------------------------------------
# Geocoding provider. "local" (default) uses the built-in zip_code_reference
# table — no API key required. Other values are reserved for future providers
# (Mapbox/Google) via the lib/geocoding provider abstraction.
GEOCODING_PROVIDER=local
# Fallback preliminary evaluation radius when the brand has no default
# configured. One of 5, 10, 15, 25.
DEFAULT_TERRITORY_RADIUS_MILES=10
# Optional webhook fired when a prospect requests a territory review
# (event: territory.review_requested). Unset outside production = simulated;
# the UI never fails because this webhook fails.
TERRITORY_REVIEW_WEBHOOK_URL=
# Optional HMAC-SHA256 secret; when set, requests carry an
# x-territory-signature header the receiver can verify.
TERRITORY_REVIEW_WEBHOOK_SECRET=

# AI Employee OS bridge: curated portal behavior events (see
# lib/os-bridge/rules.ts) POST to the OS webhook, HMAC-signed with
# x-compass-signature. Unset outside production = simulated; fire-safe.
OS_BRIDGE_WEBHOOK_URL=
OS_BRIDGE_WEBHOOK_SECRET=
# OS workspace/brand key the events belong to (default cmdt).
OS_BRIDGE_BRAND=
