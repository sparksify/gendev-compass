# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public base URL used when generating portal links (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=GenDev Capital
# Hex color, e.g. #0f2a43
NEXT_PUBLIC_PRIMARY_COLOR=
NEXT_PUBLIC_ACCENT_COLOR=
NEXT_PUBLIC_ADVISOR_NAME=Darko
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_PRIVACY_POLICY_URL=
NEXT_PUBLIC_TERMS_URL=

# ---------------------------------------------------------------------------
# Supabase (server-only — never expose the service-role key to the browser).
# Leave empty in local development to use the file-backed dev store instead.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Wistia
# ---------------------------------------------------------------------------
# The media ID of the investor overview video (the hashed ID in the Wistia URL).
WISTIA_MEDIA_ID=
NEXT_PUBLIC_WISTIA_MEDIA_ID=
# Percent of the video (1–100) required to unlock the questionnaire.
VIDEO_COMPLETION_THRESHOLD=85

# ---------------------------------------------------------------------------
# Calendar (any iframe-compatible provider: Calendly, HighLevel, Cal.com, …)
# ---------------------------------------------------------------------------
CALENDAR_EMBED_URL=
NEXT_PUBLIC_CALENDAR_EMBED_URL=

# ---------------------------------------------------------------------------
# Internal access
# ---------------------------------------------------------------------------
# Required in production. Sent as the x-api-key header to POST /api/leads.
INTERNAL_API_KEY=
# Password for the /admin/create-lead testing page.
ADMIN_TEST_PASSWORD=

# ---------------------------------------------------------------------------
# Qualification tuning (optional overrides)
# ---------------------------------------------------------------------------
# Score at/above which a lead is flagged as strong (informational for MVP).
QUALIFICATION_SCORE_THRESHOLD=60

# ---------------------------------------------------------------------------
# Analytics (optional — the portal works fully without PostHog)
# ---------------------------------------------------------------------------
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# FDD workflow / GoHighLevel integration (all server-only)
# ---------------------------------------------------------------------------
# Preferred: an inbound-webhook trigger URL for the GoHighLevel FDD workflow.
GHL_FDD_WEBHOOK_URL=
# Alternative: API mode — the contact is upserted with the request tag and a
# tag-based workflow trigger takes over.
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_FDD_WORKFLOW_ID=
GHL_FDD_REQUEST_TAG=FDD_REQUESTED
# HMAC-SHA256 secret for inbound provider webhooks (x-fdd-signature header).
# Required in production — unsigned events are rejected there.
FDD_WEBHOOK_SECRET=
# Waiting period between FDD acknowledgment and franchise-agreement
# eligibility. Confirm the exact legal duration with franchise counsel.
FDD_WAITING_PERIOD_DAYS=14
# IANA time zone used to display FDD timestamps to prospects.
NEXT_PUBLIC_BRAND_TIMEZONE=America/Chicago
