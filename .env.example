# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public base URL used when generating portal links (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=GenDev Capital
# Hex color, e.g. #0f2a43
NEXT_PUBLIC_PRIMARY_COLOR=
NEXT_PUBLIC_ACCENT_COLOR=
NEXT_PUBLIC_ADVISOR_NAME=Darko
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_PRIVACY_POLICY_URL=
NEXT_PUBLIC_TERMS_URL=

# ---------------------------------------------------------------------------
# Supabase (server-only — never expose the service-role key to the browser).
# Leave empty in local development to use the file-backed dev store instead.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Wistia
# ---------------------------------------------------------------------------
# The media ID of the investor overview video (the hashed ID in the Wistia URL).
WISTIA_MEDIA_ID=
NEXT_PUBLIC_WISTIA_MEDIA_ID=
# Percent of the video (1–100) required to unlock the questionnaire.
VIDEO_COMPLETION_THRESHOLD=85

# ---------------------------------------------------------------------------
# Calendar (any iframe-compatible provider: Calendly, HighLevel, Cal.com, …)
# ---------------------------------------------------------------------------
CALENDAR_EMBED_URL=
NEXT_PUBLIC_CALENDAR_EMBED_URL=

# ---------------------------------------------------------------------------
# Internal access
# ---------------------------------------------------------------------------
# Required in production. Sent as the x-api-key header to POST /api/leads.
INTERNAL_API_KEY=
# Password for the /admin/create-lead testing page.
ADMIN_TEST_PASSWORD=

# ---------------------------------------------------------------------------
# Qualification tuning (optional overrides)
# ---------------------------------------------------------------------------
# Score at/above which a lead is flagged as strong (informational for MVP).
QUALIFICATION_SCORE_THRESHOLD=60

# ---------------------------------------------------------------------------
# Analytics (optional — the portal works fully without PostHog)
# ---------------------------------------------------------------------------
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# FDD workflow / GoHighLevel integration (all server-only)
# ---------------------------------------------------------------------------
# Preferred: API mode — the contact is upserted with the request tag, then
# enrolled directly in the FDD workflow (no trigger configuration needed in
# GoHighLevel). Use a Private Integration token (pit-...) with Contacts +
# Workflows scopes. Location and workflow IDs have single-brand defaults in
# lib/config/fdd.ts; set these only to override.
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_FDD_WORKFLOW_ID=
# Alternative: an inbound-webhook trigger URL for the GoHighLevel FDD
# workflow (used only when no API token is configured).
GHL_FDD_WEBHOOK_URL=
GHL_FDD_REQUEST_TAG=FDD_REQUESTED
# HMAC-SHA256 secret for inbound provider webhooks (x-fdd-signature header).
# Required in production — unsigned events are rejected there.
FDD_WEBHOOK_SECRET=
# Waiting period between FDD acknowledgment and franchise-agreement
# eligibility. Confirm the exact legal duration with franchise counsel.
FDD_WAITING_PERIOD_DAYS=14
# IANA time zone used to display FDD timestamps to prospects.
NEXT_PUBLIC_BRAND_TIMEZONE=America/Chicago

# ---------------------------------------------------------------------------
# Facebook lead → private portal activation flow (see README + HIGHLEVEL_SETUP.md)
# ---------------------------------------------------------------------------
# Shared secret HighLevel sends as "Authorization: Bearer <secret>" when
# posting a Facebook lead to /api/integrations/highlevel/facebook-lead.
# Required in every environment — there is no open dev fallback for this
# endpoint since it's reachable from the public internet.
HIGHLEVEL_INBOUND_WEBHOOK_SECRET=

# How far a lead's received_at may fall from an activation's arrival and
# still be considered for automatic time-based matching. Narrow on purpose —
# widen only if real-world HighLevel delivery timing requires it.
PORTAL_AUTO_MATCH_BEFORE_SECONDS=120
PORTAL_AUTO_MATCH_AFTER_SECONDS=30
# How long the activation page polls before offering the last-four fallback.
PORTAL_ACTIVATION_MAX_WAIT_SECONDS=30
PORTAL_ACTIVATION_POLL_INTERVAL_MS=1500
# Activation cookie / row lifetime.
PORTAL_ACTIVATION_TTL_MINUTES=15
# Attempts allowed on the last-four fallback before requiring manual resolution.
PORTAL_LAST_FOUR_MAX_ATTEMPTS=5
# Kill switch: set to "false" to skip automatic time-based matching entirely
# and require the last-four fallback on every activation.
PORTAL_TIME_MATCHING_ENABLED=true

# Pushes each prospect's portal link back into HighLevel as a contact custom
# field the moment their lead is received (not gated on them clicking
# Facebook's completion button) — so HighLevel workflows can message it to
# them directly. Reuses GHL_API_TOKEN above (no separate credential).
# Create a custom field on Contacts in HighLevel with this exact key first;
# leave unset (or clear GHL_API_TOKEN) to disable the sync entirely.
GHL_PORTAL_URL_FIELD_KEY=portal_link
